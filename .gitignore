# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# --- local-only & sensitive artifacts (never push) ---
# user uploads (may contain private documents / recovery codes)
/upload/
# runtime SQLite database (schema lives in prisma/)
/db/*.db
# local backups written to download/
/download/*.db
/download/*.bundle
/download/*.tar.gz
/download/*.jpeg
/download/*.png
# logo rasterization scratch (fonts + intermediate renders)
/.logo-gen/
# original Vite export (reference copy; canonical version on GitHub main)
/olympex_export/
# runtime pid files
*.pid
