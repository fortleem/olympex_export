# Prisma datasource — SQLite file (relative to prisma/ directory).
# Local dev: points at the gitignored local database in db/.
DATABASE_URL="file:../db/custom.db"

# ── Production / Vercel note ─────────────────────────────────────────────
# Serverless filesystems are read-only, so the local SQLite file cannot be
# used in production. Keep this variable set (the build needs it), and point
# it at a writable path (e.g. file:/tmp/olympex.db) or migrate the
# QuoteRequest storage to a hosted database before going live.

# ── AI Trade Copilot (consensus engine) ─────────────────────────────────
# All five are optional — the copilot degrades to local catalogue search
# when none are configured. Get keys: console.groq.com, openrouter.ai,
# build.nvidia.com, aistudio.google.com, huggingface.co/settings/tokens.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
GOOGLE_AI_API_KEY=""
HF_API_KEY=""
